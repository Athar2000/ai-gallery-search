APP_NAME=AI Gallery Search
ENV=development
DEBUG=true

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_gallery

# Generate a real secret for production: `openssl rand -hex 32`
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma/JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# Phase 3+ (background jobs, AI)
REDIS_URL=redis://localhost:6379/0
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=openai

# "clip" for real semantic search (needs torch+open_clip_torch+internet — see
# app/ai/clip_embedder.py), or "deterministic_stub" for a dependency-free
# pixel-based stand-in used for dev/testing without real model weights.
EMBEDDING_BACKEND=clip

# "haarcascade" (default) is real and needs no setup. FACE_EMBEDDING_BACKEND:
# "arcface" for real face recognition (needs insightface+onnxruntime+internet —
# see app/ai/arcface_embedder.py), or "deterministic_stub" for dev/testing.
FACE_DETECTION_BACKEND=haarcascade
FACE_EMBEDDING_BACKEND=arcface

# "yolo" (default) is real YOLOv8n via ultralytics -- genuinely works with
# no extra setup (see app/ai/yolo_object_detector.py), but the general test
# suite sets this to "none" to stay fast; see tests/test_object_detection.py
# for the dedicated real-YOLO test.
OBJECT_DETECTION_BACKEND=yolo
